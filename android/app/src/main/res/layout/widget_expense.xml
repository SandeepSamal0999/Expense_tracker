<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:padding="14dp">

    <!-- Header row: icon + title/updated + period chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_icon_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="&#x1F4BC;"
                android:textSize="15sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expense Tracker"
                android:textColor="#F0F2FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/widget_dot"
                    android:text="" />

                <TextView
                    android:id="@+id/widget_updated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text=""
                    android:textColor="#5A6080"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="This Month &#x25BE;"
            android:textColor="#C7CBE0"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Stats row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <!-- Today column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY"
                android:textColor="#5A6080"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_today_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#x20B9;0"
                android:textColor="#00E5A0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spent today"
                android:textColor="#3A4060"
                android:textSize="9sp"
                android:layout_marginTop="1dp" />

            <LinearLayout
                android:id="@+id/widget_today_change_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_today_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text=""
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="vs yesterday"
                    android:textColor="#5A6080"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vertical divider using TextView (plain View is not allowed in RemoteViews) -->
        <TextView
            android:layout_width="1dp"
            android:layout_height="52dp"
            android:background="#1E2130"
            android:text=""
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp" />

        <!-- This Month column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THIS MONTH"
                android:textColor="#5A6080"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_month_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#x20B9;0"
                android:textColor="#F0F2FF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spent this month"
                android:textColor="#3A4060"
                android:textSize="9sp"
                android:layout_marginTop="1dp" />

            <LinearLayout
                android:id="@+id/widget_month_change_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_month_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text=""
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="vs last month"
                    android:textColor="#5A6080"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom tagline banner — only shown once the widget is resized tall enough -->
    <LinearLayout
        android:id="@+id/widget_banner_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_banner_bg"
        android:padding="10dp"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_leaf_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="&#x1F331;"
                android:textSize="11sp" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Small steps. Big freedom."
            android:textColor="#C7CBE0"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#x2192;"
            android:textColor="#00E5A0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
